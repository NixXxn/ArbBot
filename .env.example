# Use an existing deployed Polymarket Deposit Wallet (signature type 3).
POLY_SIGNATURE_TYPE=3
POLY_PRIVATE_KEY=
# Prefer the Deposit Wallet address here. If this equals the signer EOA, the live
# adapter omits it and lets the SDK default to that signer's Deposit Wallet.
POLY_FUNDER=
# Switch to 0 only when you intend to enable live entries.
LIVE_KILL=1
# Existing signer-bound API credentials are derived in memory.
# The single-entry adapter does not need stale website POLY_API_* values.
# Required by run_ten.py for hold-to-resolution redemption:
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
# Dashboard deployments use HTTPS Basic authentication.
DASHBOARD_USER=admin
DASHBOARD_TOKEN=replace-with-at-least-16-random-characters
BOT_MODE=dashboard
BOT_INITIAL_MODE=paper
BOT_STRATEGY=arbitrage
# arbitrage | cross_venue | combined
PAPER_BUDGET=1000
# minimum (default) or adaptive; retained for compatibility (live gated).
LIVE_SIZING=minimum
# Kalshi (cross-venue). Prefer path to PEM private key.
KALSHI_KEY_ID=
KALSHI_PK=
# Or: KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi.pem
