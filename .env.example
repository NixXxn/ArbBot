# Dashboard (Coolify / Basic auth)
DASHBOARD_USER=admin
DASHBOARD_TOKEN=replace-with-at-least-16-random-characters
BOT_MODE=dashboard
PORT=8080
BOT_DATA_DIR=data

# Safety: keep LIVE_KILL=1 for dry-run. Set LIVE_KILL=0 and DRY_RUN=false for live.
LIVE_KILL=1
DRY_RUN=true

# Markets — either one event pair, OR scan everything:
# SCAN_ALL=true
# SCAN_LIMIT_POLY=100
# SCAN_LIMIT_KALSHI=100
# SCAN_QUERY=           # optional, e.g. fed / bitcoin
# SCAN_SORT=volume
# MATCHING_THRESHOLD=0.6   # lower = more fuzzy matches
# TOP_N_OPPORTUNITIES=20
#
# Single-event mode (set SCAN_ALL=false and both URLs):
SCAN_ALL=true
POLYMARKET_URL=
KALSHI_URL=

# Strategy
TRADING_MODE=CONSERVATIVE
TRADE_AMOUNT_CENTS=100
MIN_PROFIT_CENTS=1
POLL_INTERVAL_SECONDS=60
# Matching (RF-enthusiast features ported to Node — cleaner text + numbers + entities)
MATCHING_THRESHOLD=0.55
TOP_N_OPPORTUNITIES=20

# After each exit: keep both venues funded (50/50 trade budget).
# Live cannot auto-wire Poly↔Kalshi banks; dashboard shows the transfer amount.
REBALANCE_ENABLED=true
REBALANCE_TARGET_RATIO=0.5
REBALANCE_MIN_DELTA_USD=1
PAPER_BUDGET=1000

# pmxt hosted API (recommended for reads)
PMXT_API_KEY=

# Polymarket (legacy ArbBot names work)
POLY_SIGNATURE_TYPE=3
POLY_PRIVATE_KEY=
POLY_FUNDER=
# Or: POLYMARKET_PRIVATE_KEY=  POLYMARKET_PROXY_ADDRESS=

# Kalshi (legacy ArbBot names work)
KALSHI_KEY_ID=
KALSHI_PK=
# Or: KALSHI_API_KEY=  KALSHI_PRIVATE_KEY=
